extends RefCounted

# Original deterministic terrain materials; generated by assets/terrain/generate.py.
# These are visual assets only: footprints, navigation and harvesting stay in simulation.
const DATA = preload("res://scripts/catalog.gd")
const PROJ = preload("res://scripts/projection.gd")
const SOIL = preload("res://assets/terrain/wasteland.png")
const CLIFF_LONG = preload("res://assets/terrain/cliff_256x384.png")
const CLIFF_SHORT = preload("res://assets/terrain/cliff_256x224.png")
const WELL = preload("res://assets/terrain/spiritual_well.png")
const ESSENCE = preload("res://assets/terrain/essence_growth.png")
const ESSENCE_CELL := Vector2(96, 80)

static func ground(canvas: CanvasItem, map_size: Vector2 = DATA.MAP_SIZE) -> void:
	# Soil and the existing road are one continuous material, without tile boundaries.
	canvas.draw_set_transform_matrix(Transform2D(Vector2(1, 0.5), Vector2(-1, 0.5), Vector2(map_size.y, 0)))
	canvas.draw_texture_rect(SOIL, Rect2(Vector2.ZERO, map_size), false)
	canvas.draw_set_transform(Vector2.ZERO)
	var edge: PackedVector2Array = PROJ.footprint(map_size / 2.0, map_size, map_size)
	edge.append(edge[0])
	canvas.draw_polyline(edge, Color("303a2b"), 1.5, true)

static func cliff(canvas: CanvasItem, rect: Rect2, map_size: Vector2 = DATA.MAP_SIZE) -> void:
	var long_cliff: bool = rect.size.y > 300.0
	var texture: Texture2D = CLIFF_LONG if long_cliff else CLIFF_SHORT
	var anchor := Vector2(352, 248) if long_cliff else Vector2(272, 208)
	canvas.draw_texture(texture, PROJ.project(rect.get_center(), map_size) - anchor)

static func well(canvas: CanvasItem, position: Vector2) -> void:
	canvas.draw_texture(WELL, position - Vector2(64, 64))

static func essence(canvas: CanvasItem, position: Vector2, fullness: float) -> void:
	var stage: int = clampi(1 + floori(fullness * 6.0), 1, 7) if fullness > 0 else 0
	var source := Rect2(Vector2(stage % 4, stage >> 2) * ESSENCE_CELL, ESSENCE_CELL)
	canvas.draw_texture_rect_region(ESSENCE, Rect2(position - Vector2(48, 50), ESSENCE_CELL), source)
