static var _faction_spec_cache: Dictionary = {}

static func spec(kind: String, faction: String = "") -> Dictionary:
	var overrides: Dictionary = FACTION_SPECS.get(faction, {})
	if not overrides.has(kind):
		return SPECS.get(kind, {})
	var key: String = faction + ":" + kind
	if not _faction_spec_cache.has(key):
		var definition: Dictionary = SPECS[kind].duplicate()
		definition.merge(overrides[kind], true)
		_faction_spec_cache[key] = definition
	return _faction_spec_cache[key]

static func title(kind: String, owner: int = 0) -> String:
	return faction_title(kind, FACTIONS[clampi(owner, 0, 1)])

static func faction_name(faction: String) -> String:
	return str(FACTION_NAMES.get(faction, faction.capitalize()))

static func faction_title(kind: String, faction: String) -> String:
	var names: Dictionary = FACTION_UNITS.get(faction, {})
	if names.has(kind):
		return str(names[kind])
	var structures: Dictionary = FACTION_BUILDINGS.get(faction, {})
	if structures.has(kind):
		return str(structures[kind])
	return str({"hq": "Command Center", "power": "Power Plant", "refinery": "Refinery", "barracks": "Barracks", "factory": "Factory"}.get(kind, kind.capitalize()))

static func requirements(kind: String, _faction: String = "") -> Array:
	return BUILDING_PREREQUISITES.get(kind, UNIT_PREREQUISITES.get(kind, []))
