; CommandPower — Godot 4.5.1
config_version=5

[application]
config/name="CommandPower"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1366
window/size/viewport_height=864
window/size/window_width_override=1366
window/size/window_height_override=864
window/size/min_width=1100
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.027, 0.042, 0.054, 1)

[physics]
common/physics_ticks_per_second=20
